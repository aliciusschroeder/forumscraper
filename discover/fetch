# prints pages from URLs loaded by forumscraper's browser

import sys

from forumscraper.session import Session
from forumscraper.exceptions import RequestError

session = Session(timeout=120, verify=False, retry=0)
try:
    for url in sys.argv[1:]:
        try:
            print(session.request(url).text)
        except RequestError as e:
            print(url, e, file=sys.stderr)
finally:
    session.close()
